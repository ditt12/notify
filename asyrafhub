--// ASYRAF HUB - KICK CODE DETECTOR + TELEGRAM + AUTO REJOIN
--// =========================================================

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer

--// ================= CONFIG =================
local TOKEN = "8538531375:AAHJYgPsvydBm-HTu7_VYVfP17BrUv2c3g8"
local CHAT_ID = "6554802149"

--// ================= REQUEST =================
local request =
    (syn and syn.request)
    or http_request
    or request
    or (http and http.request)

--// ================= TELEGRAM =================
local function sendTelegram(msg)
    if not request then
        warn("No HTTP request support")
        return
    end

    pcall(function()
        request({
            Url = "https://api.telegram.org/bot" .. TOKEN .. "/sendMessage",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = HttpService:JSONEncode({
                chat_id = CHAT_ID,
                text = msg
            })
        })
    end)
end

--// ================= FORMAT =================
local function formatMsg(reason, code)
    return table.concat({
        "🚨 ROBLOX KICK DETECTED",
        "",
        "👤 User: " .. LocalPlayer.Name,
        "🆔 UserId: " .. LocalPlayer.UserId,
        "",
        "🎮 PlaceId: " .. game.PlaceId,
        "📡 JobId: " .. game.JobId,
        "",
        "❌ Code: " .. tostring(code),
        "📄 Reason: " .. tostring(reason),
        "",
        "⏱ Time: " .. os.date("%H:%M:%S")
    }, "\n")
end

--// ================= AUTO REJOIN =================
local function rejoin()
    task.wait(2)

    pcall(function()
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end)
end

--// ================= DETECT KICK =================
local mt = getrawmetatable(game)
setreadonly(mt, false)

local old = mt.__namecall

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if method == "Kick" then
        local reason = args[1] or "Unknown"

        local code =
            tostring(reason):match("(%d%d%d)")
            or "UNKNOWN"

        sendTelegram(formatMsg(reason, code))

        warn("[ASYRAF HUB] KICK DETECTED:", reason)

        task.spawn(rejoin)
    end

    return old(self, ...)
end)

--// ================= LOG BACKUP DETECTOR =================
game:GetService("LogService").MessageOut:Connect(function(msg, type)
    if type == Enum.MessageType.MessageError then
        local code = msg:match("(%d%d%d)") or "UNKNOWN"

        sendTelegram(formatMsg(msg, code))
    end
end)

print("[ASYRAF HUB] Kick detector running...")
