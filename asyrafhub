--=========================================
-- ERROR DETECTION
--=========================================

local function detectError(message)

    for code, reason in pairs(ErrorCodes) do

        if tostring(message):find(code) then

            restartCount += 1

            sendTelegram(
                "🔴 Crash Detected",
                "Account `" .. LocalPlayer.Name .. "` crashed/rejoined",
                {

                    "👤 *Username*\n`" .. LocalPlayer.Name .. "`",

                    "⚠️ *Error Code*\n`" .. code .. "`",

                    "📄 *Reason*\n`" .. reason .. "`",

                    "📝 *Message*\n`" .. tostring(message) .. "`",

                    "🔁 *Restart Count*\n`" .. restartCount .. "`",

                    "📡 *Action*\n`Auto Restarting...`",

                    "🎮 *Game*\n`" .. GameName .. "`",

                    "⏱️ *Time*\n`" .. os.date("%X") .. "`"
                }
            )

            warn("[AsyrafHub] Error Detected:", code)

            break
        end
    end
end

--=========================================
-- GUI ERROR DETECT
--=========================================

GuiService.ErrorMessageChanged:Connect(function(message)

    if message and message ~= "" then

        print("[AsyrafHub] Error:", message)

        detectError(message)

    end
end)

--=========================================
-- TELEPORT FAILED
--=========================================

LocalPlayer.OnTeleport:Connect(function(state)

    if state == Enum.TeleportState.Failed then
        detectError("769")
    end
end)

--=========================================
-- PLAYER DISCONNECT
--=========================================

LocalPlayer:GetPropertyChangedSignal("Parent"):Connect(function()

    if not LocalPlayer.Parent then
        detectError("277")
    end
end)

--=========================================
-- HEARTBEAT FREEZE DETECT
--=========================================

local lastTick = tick()

game:GetService("RunService").Heartbeat:Connect(function()
    lastTick = tick()
end)

task.spawn(function()

    while task.wait(10) do

        if tick() - lastTick > 15 then
            detectError("2006")
        end
    end
end)

