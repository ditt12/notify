        chatid = tostring(getgenv().CHAT_ID or "")
    end

    if token == "" then
        token = "8538531375:AAHJYgPsvydBm-HTu7_VYVfP17BrUv2c3g8"
    end

    if chatid == "" then
        chatid = "6554802149"
    end

    config = {
        token = token,
        chat_id = chatid
    }

    saveJSON(CONFIG_FILE, config)

    print("[AsyrafHub] Config Saved")
end

--=========================================
-- REQUEST FUNCTION
--=========================================

local requestfunc =
    (syn and syn.request)
    or (http and http.request)
    or http_request
    or request
    or fluxus and fluxus.request

--=========================================
-- TELEGRAM SEND
--=========================================

local function sendTelegram(title, description, fields)

    local text = ""
    text = text .. "━━━━━━━━━━━━━━\n"
    text = text .. "*" .. title .. "*\n\n"
    text = text .. description .. "\n\n"

    for _, field in ipairs(fields) do
        text = text .. field .. "\n\n"
    end

    text = text .. "━━━━━━━━━━━━━━"

    local body = {
        chat_id = config.chat_id,
        text = text,
        parse_mode = "Markdown"
    }

    local success, response = pcall(function()

        return requestfunc({
            Url = "https://api.telegram.org/bot" .. config.token .. "/sendMessage",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = HttpService:JSONEncode(body)
        })

    end)

    if success then
        print("[AsyrafHub] Telegram Sent")
    else
        warn("[AsyrafHub] Failed Send Telegram")
    end
end

