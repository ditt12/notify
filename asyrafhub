--// =========================================================
--// ERROR DETECTION
--// =========================================================

local alreadyDetected = false

local function detectError()
    if alreadyDetected then
        return
    end

    local PromptGui = CoreGui:FindFirstChild("RobloxPromptGui")

    if not PromptGui then
        return
    end

    local TextLabel =
        PromptGui:FindFirstChildWhichIsA(
            "TextLabel",
            true
        )

    if not TextLabel then
        return
    end

    local text = TextLabel.Text

    if not text or text == "" then
        return
    end

    local errorCode =
        text:match("Error Code:?%s*(%d+)")
        or text:match("error code:?%s*(%d+)")
        or text:match("(%d+)")

    if errorCode then
        alreadyDetected = true

        print("[ASYRAF HUB] Error detected:", errorCode)

        local msg = buildMessage(errorCode, text)

        sendTelegram(msg)
    end
end

